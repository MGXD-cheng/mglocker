<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 开机自启：电视重启后自动进入锁定 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 局域网 HTTP 远程控制服务 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 悬浮窗权限：声明即可，部分 ROM 会对持有该权限的应用放行后台启动 Activity（Home 弹回更稳） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- v2.0：网络变化广播（CONNECTIVITY_CHANGE）需要此权限，作为额外复活通道 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">

        <!-- 锁机主界面：启动即进入 Kiosk 锁定模式 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:lockTaskMode="if_whitelisted"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 开机自启接收器：重启后直接拉起锁定界面 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 守护服务：常驻前台，提升进程优先级，保证 Home 弹回及时 -->
        <service
            android:name=".GuardService"
            android:exported="false" />

        <!-- 心跳保活：每 30 秒被系统闹钟唤醒，进程被杀后自动复活并恢复锁定（辅助通道，可能被部分 ROM 吞掉） -->
        <receiver
            android:name=".HeartbeatReceiver"
            android:exported="false" />

        <!-- v2.0 系统级广播复活：TIME_TICK（每分钟）/ 屏幕亮灭 / 用户唤醒 / 网络变化。
             由系统时钟与事件驱动，ROM 无法单独禁用，进程被杀后由系统广播强制重建进程并复活锁定 -->
        <receiver
            android:name=".ReviveReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_TICK" />
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- 设备管理员：激活后应用不可卸载、不可强停，Lock Task 硬锁生效 -->
        <receiver
            android:name=".AdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>